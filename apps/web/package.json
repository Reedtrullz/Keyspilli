{
  "name": "@keyspilli/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build-offline.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.song-tools.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:scratch": "playwright test --config=playwright.scratch.config.ts",
    "e2e:melody-scratch": "playwright test --config=playwright.melody.scratch.config.ts",
    "e2e:proxy": "playwright test --config=playwright.proxy.config.ts",
    "predev": "node scripts/build-offline.mjs"
  },
  "dependencies": {
    "@keyspilli/catalog": "workspace:*",
    "@keyspilli/engrave": "workspace:*",
    "@keyspilli/midi": "workspace:*",
    "@keyspilli/player-core": "workspace:*",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "smplr": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
