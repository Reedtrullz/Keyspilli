# Shared pinned extraction runtime; default target is the CLI, --target worker serves jobs.
FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS node-build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/catalog/package.json packages/catalog/package.json
COPY packages/engrave/package.json packages/engrave/package.json
COPY packages/midi/package.json packages/midi/package.json
COPY packages/player-core/package.json packages/player-core/package.json
COPY services/transcribe/package.json services/transcribe/package.json
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm ci --no-audit --no-fund
COPY packages packages
COPY services services
COPY catalog catalog
COPY apps/web apps/web
RUN npm run typecheck -w @keyspilli/transcribe

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS extractor
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libfluidsynth3 libgl1 libegl1 libasound2 libjack-jackd2-0 \
    && rm -rf /var/lib/apt/lists/*
COPY services/transcribe/requirements-tutorial.txt /app/requirements.txt
# Resolve declared dependencies, then fail on inconsistency: never conceal gaps with --no-deps.
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.txt && pip check
COPY services/transcribe/src/tutorial_keys.py services/transcribe/src/tutorial_timing.py /app/src/
COPY services/transcribe/test/test_tutorial_keys.py services/transcribe/test/test_tutorial_timing.py /app/test/
RUN python -c "from lumachords.keybed_detector import KeybedDetector; from lumachords.image_input import ImagePreprocessor; from lumachords.preferences import Preferences; from lumachords.runtime_config import RuntimeConfig, AppMode, ProdMode, LogLevel; KeybedDetector(Preferences(), RuntimeConfig(AppMode.HEADLESS, ProdMode.PROD, LogLevel.LOGLEVEL_NONE)).init_state()"
RUN python -m unittest discover -s /app/test -p 'test_tutorial_*.py'
USER 65532:65532
ENTRYPOINT ["python", "/app/src/tutorial_keys.py"]
CMD ["--help"]

FROM extractor AS worker
COPY --from=node-build /usr/local/bin/node /usr/local/bin/node
COPY --from=node-build /app /app
RUN cmp /app/requirements.txt /app/services/transcribe/requirements-tutorial.txt \
    && cmp /app/src/tutorial_keys.py /app/services/transcribe/src/tutorial_keys.py \
    && cmp /app/src/tutorial_timing.py /app/services/transcribe/src/tutorial_timing.py
ENV NODE_ENV=production \
    KEYSPILLI_DATA_DIR=/data KEYSPILLI_TUTORIAL_PYTHON=/usr/local/bin/python \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
USER 65532:65532
ENTRYPOINT ["node"]
CMD ["--import", "tsx", "services/transcribe/src/worker.ts"]

FROM extractor AS cli
