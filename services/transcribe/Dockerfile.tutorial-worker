# Isolated full-pipeline smoke candidate; not a production deployment image.
FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS node-build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/catalog/package.json packages/catalog/package.json
COPY packages/engrave/package.json packages/engrave/package.json
COPY packages/midi/package.json packages/midi/package.json
COPY packages/player-core/package.json packages/player-core/package.json
COPY services/transcribe/package.json services/transcribe/package.json
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm ci --no-audit --no-fund
COPY packages packages
COPY services services
COPY catalog catalog
COPY apps/web apps/web
RUN npm run typecheck -w @keyspilli/transcribe

# Build Dockerfile.tutorial first and retain its image identity in the smoke receipt.
FROM keyspilli-tutorial:candidate
COPY --from=node-build /usr/local/bin/node /usr/local/bin/node
COPY --from=node-build /app /app
ENV NODE_ENV=development KEYSPILLI_TUTORIAL_PREVIEW=1 \
    KEYSPILLI_DATA_DIR=/data KEYSPILLI_TUTORIAL_PYTHON=/usr/local/bin/python \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
USER 65532:65532
ENTRYPOINT ["node"]
CMD ["--import", "tsx", "services/transcribe/src/worker.ts"]
