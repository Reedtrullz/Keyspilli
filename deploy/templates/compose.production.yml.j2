services:
  web:
    image: "{{ compose_image | default(docker_image) }}"
    container_name: "{{ container_name }}"
    restart: unless-stopped
    env_file:
      - "{{ source_search_env_file }}"
    ports:
      - "{{ app_bind_address }}:{{ app_host_port }}:3000"
    environment:
      NODE_ENV: production
      PORT: "3000"
      HOSTNAME: "0.0.0.0"
      VERSION: "{{ compose_app_version | default(app_version) }}"
      IMAGE_REF: "{{ compose_image | default(docker_image) }}"
      KEYSPILLI_API_TOKEN: "{{ keyspilli_api_token | default('') }}"
      KEYSPILLI_DATA_DIR: /data
      KEYSPILLI_TUTORIAL_BETA: "{{ '1' if (compose_tutorial_beta | default(keyspilli_tutorial_beta)) | bool else '0' }}"
      # PDF rendering runs Chromium inside this container. The host-mapped
      # port is not reachable from the container namespace, so keep the
      # internal origin on the application listener.
      KEYSPILLI_ORIGIN: "http://127.0.0.1:3000"
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          node -e "require('http').get('http://127.0.0.1:3000/api/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 10s
      start_period: 40s
      retries: 3
    volumes:
      - keyspilli_data:/data
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

  worker:
    image: "{{ compose_worker_image | default(worker_image) }}"
    container_name: "{{ worker_container_name }}"
    restart: unless-stopped
    # The SSH download relay listens only on host loopback.
    network_mode: host
    # Match the existing managed volume owner without changing catalogue files.
    user: "1000:1000"
    environment:
      NODE_ENV: production
      KEYSPILLI_DATA_DIR: /data
      KEYSPILLI_TUTORIAL_BETA: "{{ '1' if (compose_tutorial_beta | default(keyspilli_tutorial_beta)) | bool else '0' }}"
      KEYSPILLI_BP_SERIALIZATION: onnx
      KEYSPILLI_YT_PROXY: "{{ keyspilli_yt_proxy | default('') }}"
      KEYSPILLI_YT_COOKIES: "{{ '/run/secrets/keyspilli_youtube_cookies' if (keyspilli_yt_cookies_path | default('') | length > 0) else '' }}"
    volumes:
      - keyspilli_data:/data
{% if keyspilli_yt_cookies_path | default('') | length > 0 %}
      - "{{ keyspilli_yt_cookies_path }}:/run/secrets/keyspilli_youtube_cookies:ro"
{% endif %}
    depends_on:
      - web
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

volumes:
  keyspilli_data:
