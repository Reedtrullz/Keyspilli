#!/usr/bin/env bash
set -euo pipefail

DOCKER_BIN="${KEYSPILLI_DOCKER_BIN:-/usr/bin/docker}"
TIMEOUT_BIN="${KEYSPILLI_TIMEOUT_BIN:-timeout}"
BACKUP_TIMEOUT="${KEYSPILLI_BACKUP_TIMEOUT:-300s}"
LOCK_FILE="${KEYSPILLI_BACKUP_LOCK:-/run/lock/keyspilli-backup.lock}"
BACKUP_SCRIPT="${KEYSPILLI_BACKUP_SCRIPT:-{{ app_dir }}/backup.sh}"
BACKUP_DIR="${KEYSPILLI_BACKUP_DIR:-/backups}"
PAUSED_BY_US=()
BACKUP_CONTAINER="keyspilli-backup-$$"

die() {
  echo "backup runner failed: $*" >&2
  exit 1
}

mkdir -p "$(dirname "$LOCK_FILE")" "$BACKUP_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || die "another backup runner is active"

inspect_state() {
  local name="$1" state
  state="$("$DOCKER_BIN" inspect --format '{% raw %}{{.State.Status}} {{.State.Paused}}{% endraw %}' "$name")" \
    || die "cannot inspect $name"
  case "$state" in
    "running false"|"paused true") printf '%s\n' "$state" ;;
    *) die "$name is not in a safe state: $state" ;;
  esac
}

pause_writer() {
  local name="$1" state
  state="$(inspect_state "$name")"
  if [[ "$state" == "running false" ]]; then
    "$DOCKER_BIN" pause "$name" >/dev/null || die "cannot pause $name"
    PAUSED_BY_US+=("$name")
    [[ "$(inspect_state "$name")" == "paused true" ]] || die "$name did not remain paused"
  fi
}

unpause_writers() {
  local name state failed=0
  for name in "${PAUSED_BY_US[@]}"; do
    if ! "$DOCKER_BIN" unpause "$name" >/dev/null; then
      echo "backup runner: failed to unpause $name" >&2
      failed=1
      continue
    fi
    if ! state="$($DOCKER_BIN inspect --format '{% raw %}{{.State.Status}} {{.State.Paused}}{% endraw %}' "$name")" || [[ "$state" != "running false" ]]; then
      echo "backup runner: $name did not return to running state" >&2
      failed=1
    fi
  done
  return "$failed"
}

cleanup_backup_container() {
  if "$DOCKER_BIN" rm -f "$BACKUP_CONTAINER" >/dev/null 2>&1; then return 0; fi
  if "$DOCKER_BIN" inspect "$BACKUP_CONTAINER" >/dev/null 2>&1; then
    echo "backup runner: failed to remove $BACKUP_CONTAINER" >&2
    return 1
  fi
}

on_exit() {
  local rc=$?
  if ! cleanup_backup_container; then rc=1; fi
  if ! unpause_writers; then rc=1; fi
  exit "$rc"
}
on_signal() { exit 143; }
trap on_exit EXIT
trap on_signal TERM INT

pause_writer keyspilli
pause_writer keyspilli-worker

image="$("$DOCKER_BIN" inspect keyspilli-worker --format '{% raw %}{{.Config.Image}}{% endraw %}')" \
  || die "keyspilli-worker image is unavailable"
[[ -n "$image" ]] || die "keyspilli-worker image is empty"

# The one-shot backup writes root-owned host backups; do not inherit the worker UID.
"$TIMEOUT_BIN" --foreground --signal=TERM --kill-after=30s "$BACKUP_TIMEOUT" \
  "$DOCKER_BIN" run --rm --name "$BACKUP_CONTAINER" \
  --user 0:0 \
  --network none \
  --volumes-from keyspilli-worker \
  -v "$BACKUP_DIR:/backups" \
  -v "$BACKUP_SCRIPT:/usr/local/bin/keyspilli-backup:ro" \
  -e KEYSPILLI_DATA_DIR=/data \
  -e KEYSPILLI_BACKUP_DIR=/backups \
  --entrypoint /bin/bash \
  "$image" /usr/local/bin/keyspilli-backup

echo "backup runner complete"
