{
  "name": "keyspilli",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @keyspilli/web",
    "build": "npm run build -w @keyspilli/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify-catalog": "npm run verify-catalog -w @keyspilli/catalog",
    "migrate-artifacts": "npm run migrate-artifacts -w @keyspilli/catalog --",
    "audit-catalog": "npm run audit-catalog -w @keyspilli/catalog",
    "compare-piano-fixtures": "npm run compare-piano-fixtures -w @keyspilli/catalog",
    "quality-report": "npm run quality-report -w @keyspilli/catalog",
    "learner-audit": "npm run learner-audit -w @keyspilli/catalog",
    "learner-report": "npm run learner-report -w @keyspilli/catalog",
    "verify-chord-sources": "npm run verify-chord-sources -w @keyspilli/catalog",
    "calibrate": "npm run calibrate -w @keyspilli/catalog",
    "pipeline": "npm run pipeline -w @keyspilli/catalog",
    "seed": "npm run seed -w @keyspilli/catalog",
    "evaluate-metal": "npm run evaluate-metal -w @keyspilli/catalog --",
    "research:song": "npm run research:song -w @keyspilli/catalog --",
    "render:midi": "npm run render:midi -w @keyspilli/catalog --",
    "build:listening": "npm run build:listening -w @keyspilli/catalog --",
    "diagnose:piano-candidates": "npm run diagnose:piano-candidates -w @keyspilli/catalog --",
    "build:piano-section-listening": "npm run build:piano-section-listening -w @keyspilli/catalog --",
    "benchmark:score": "npm run benchmark:score -w @keyspilli/catalog --",
    "benchmark:scores": "npm run benchmark:scores -w @keyspilli/catalog --"
  },
  "engines": {
    "node": ">=20"
  }
}
