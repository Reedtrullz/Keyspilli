{
  "name": "keyspilli",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @keyspilli/web run dev",
    "build": "pnpm --filter @keyspilli/web run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "lint": "eslint .",
    "lint:py": "ruff check .",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "verify-catalog": "pnpm --filter @keyspilli/catalog run verify-catalog",
    "migrate-artifacts": "pnpm --filter @keyspilli/catalog run migrate-artifacts",
    "audit-catalog": "pnpm --filter @keyspilli/catalog run audit-catalog",
    "compare-piano-fixtures": "pnpm --filter @keyspilli/catalog run compare-piano-fixtures",
    "quality-report": "pnpm --filter @keyspilli/catalog run quality-report",
    "learner-audit": "pnpm --filter @keyspilli/catalog run learner-audit",
    "learner-report": "pnpm --filter @keyspilli/catalog run learner-report",
    "verify-chord-sources": "pnpm --filter @keyspilli/catalog run verify-chord-sources",
    "calibrate": "pnpm --filter @keyspilli/catalog run calibrate",
    "pipeline": "pnpm --filter @keyspilli/catalog run pipeline",
    "seed": "pnpm --filter @keyspilli/catalog run seed",
    "evaluate-metal": "pnpm --filter @keyspilli/catalog run evaluate-metal",
    "evaluate:upstream-guitar": "pnpm --filter @keyspilli/catalog run evaluate:upstream-guitar",
    "research:song": "pnpm --filter @keyspilli/catalog run research:song",
    "render:midi": "pnpm --filter @keyspilli/catalog run render:midi",
    "build:listening": "pnpm --filter @keyspilli/catalog run build:listening",
    "build:rotating-listening": "pnpm --filter @keyspilli/catalog run build:rotating-listening",
    "diagnose:piano-candidates": "pnpm --filter @keyspilli/catalog run diagnose:piano-candidates",
    "build:piano-section-listening": "pnpm --filter @keyspilli/catalog run build:piano-section-listening",
    "benchmark:score": "pnpm --filter @keyspilli/catalog run benchmark:score",
    "benchmark:scores": "pnpm --filter @keyspilli/catalog run benchmark:scores",
    "report:melody-review": "pnpm --filter @keyspilli/catalog run report:melody-review",
    "build:midi-corpus": "pnpm --filter @keyspilli/catalog run build:midi-corpus",
    "evaluate:cover-rh-cliff": "pnpm --filter @keyspilli/catalog run evaluate:cover-rh-cliff",
    "evaluate:beginner-offgrid-rh-frontier": "pnpm --filter @keyspilli/catalog run evaluate:beginner-offgrid-rh-frontier",
    "preflight": "node --import tsx apps/web/scripts/runtime-preflight.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "pnpm@10.34.5"
}
